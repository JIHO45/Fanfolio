    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission is required to save your game records and win-rate cards to your photo library."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직관 기록과 승률 카드를 기기의 사진첩에 저장하기 위해 접근 권한이 필요합니다."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access to your photo library is required to select ticket and profile photos."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "티켓·프로필 사진을 선택하기 위해 사진 라이브러리 접근이 필요합니다."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays stadiums and match venues on the map, and helps localize map and place search results."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직관 지도에서 구장·경기 장소를 표시하고, 지도·장소 검색 결과를 맞추기 위해 사용합니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
