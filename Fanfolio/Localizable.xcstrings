        }
      }
    },
    "settings.logout.message": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 화면으로 돌아갑니다. 직관·문화 기록과 티켓 사진 등 앱 데이터는 이 기기에서 삭제되지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll return to the sign-in screen. Match and culture records and ticket photos on this device are not deleted."
          }
        }
      }
