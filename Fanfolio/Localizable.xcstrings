{
  "sourceLanguage": "ko",
  "strings": {
    "api.error.dailyLimitExceeded": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 API 호출 한도(100회)를 초과했습니다. 내일 다시 시도해주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s API call limit (100) has been exceeded. Try again tomorrow."
          }
        }
      }
    },
    "api.error.decodingFailedFormat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 파싱 오류: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data parsing error: %@"
          }
        }
      }
    },
    "api.error.invalidURL": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 API URL입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid API URL."
          }
        }
      }
    },
    "api.error.networkErrorFormat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 오류: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network error: %@"
          }
        }
      }
    },
    "api.error.noAPIKey": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키가 설정되지 않았습니다. 프로젝트 루트에서 APIKeys.xcconfig.example을 복사해 APIKeys.xcconfig를 만들고 API_SPORTS_KEY를 넣은 뒤 다시 빌드하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No API key set. Copy APIKeys.xcconfig.example to APIKeys.xcconfig in the project root, add API_SPORTS_KEY, then rebuild."
          }
        }
      }
    },
    "api.error.noData": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data available."
          }
        }
      }
    },
    "auth.continueAsGuest": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 없이 시작"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without signing in"
          }
        }
      }
    },
    "auth.feature.cultureArchive": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘서트, 뮤지컬 관람을 아카이빙하세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive concerts, musicals, and more"
          }
        }
      }
