    "settings.deleteAccount.message": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 Apple 로그인 식별 정보와 이름·이메일(저장된 경우), 프로필 사진이 제거됩니다. 직관·문화 기록과 티켓 이미지는 그대로 남습니다. iCloud에 동기화된 데이터는 기기의 iCloud 설정에서 관리됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in identifiers and saved name, email (if any), and profile photo are removed from this device. Match and culture records and ticket images stay. Data synced to iCloud is managed in device iCloud settings."
          }
        }
      }
    },
    "settings.deleteAccount.title": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 삭제"
