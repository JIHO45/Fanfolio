      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직관 경기를 기록하고 승률을 확인하세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log games you attend and track win rate"
          }
        }
      }
    },
    "auth.guestModeDisclaimer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 없이도 모든 기능을 사용할 수 있습니다.\niCloud 동기화는 기기 설정에서 자동으로 작동합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can use all features without signing in.\niCloud sync works automatically from device settings."
          }
        }
      }
    },
