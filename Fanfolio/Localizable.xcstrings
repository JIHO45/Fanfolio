    "settings.backup.footer.files" : {
      "comment" : "A footer text in the settings backup view, explaining how to backup only the photos folder.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To back up photo folders only, connect your device in Finder (Mac) or Apple Devices, go to Files → Fanfolio, then copy the MatchPhotos, CulturePhotos, and TicketImages folders from Documents."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사진 폴더만 백업하려면 Mac의 Finder 또는 애플 기기 지원 앱에서 기기 → 파일 공유 → Fanfolio로 이동한 뒤, 문서 안의 MatchPhotos·CulturePhotos·TicketImages 폴더를 그대로 복사해 두면 됩니다."
          }
        }
      }
    },
    "settings.backup.footer.json" : {
      "comment" : "A footer description for the JSON backup option, explaining that the backup includes recorded data, photo and ticket image file paths, and small QR images. It also notes that the app does not automatically restore these files.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON may include records, relative paths to photo and ticket files, and small QR images. This app does not import or restore files automatically."
          }
        },
        "ko" : {
