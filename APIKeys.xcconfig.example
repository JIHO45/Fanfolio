// 이 파일을 복사해 `APIKeys.xcconfig`로 저장한 뒤 실제 키를 넣으세요.
//   cp APIKeys.xcconfig.example APIKeys.xcconfig
// APIKeys.xcconfig는 Git에 커밋하지 마세요.
API_SPORTS_KEY = YOUR_API_SPORTS_KEY_HERE
// Mapbox: https://account.mapbox.com/access-tokens/ 에서 Public token (pk.로 시작) 생성.
// 대시보드에서 URL 제한·번들 ID(iOS: com.your.app) 제한을 켜 두면 유출 시 피해를 줄일 수 있습니다.
MAPBOX_ACCESS_TOKEN = YOUR_MAPBOX_PUBLIC_TOKEN_HERE
// Firebase: https://console.firebase.google.com → 프로젝트 설정 → 일반 탭에서 확인.
// FIREBASE_PROJECT_ID: 프로젝트 ID (예: my-fanfolio-app)
// FIREBASE_WEB_API_KEY: 웹 API 키 (AIza...로 시작하는 공개 키)
FIREBASE_PROJECT_ID = YOUR_FIREBASE_PROJECT_ID_HERE
FIREBASE_WEB_API_KEY = YOUR_FIREBASE_WEB_API_KEY_HERE
// (선택) 앱·App Store Connect에 넣을 개인정보 처리방침 URL. DeveloperSettings.xcconfig에도 동일 키로 둘 수 있습니다.
// PRIVACY_POLICY_URL = https://www.notion.so/your-public-privacy-page
